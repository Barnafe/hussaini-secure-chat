# Copy this file to ".env" and edit. Never commit your real .env (it is git-ignored).

# --- Server -------------------------------------------------------------
# Neon (PostgreSQL) connection string. Leave EMPTY to use a local SQLite file (data/chat.db).
# Example: postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Port to listen on (Render sets PORT by itself).
PORT=8765

# bcrypt cost factor for password hashing (12 is a good default).
BCRYPT_ROUNDS=12

# --- Client -------------------------------------------------------------
# Pre-fills the "Server" box of the login window. Local: ws://localhost:8765
# Deployed: wss://your-app.onrender.com
CHAT_SERVER_URL=ws://localhost:8765
